# ============================================
# Сценарий 3: Прокси к удалённому бэкенду с другим origin
# Используется когда бэкенд на 192.168.1.97, но CORS проверяет Origin
# changeOrigin:true + rewrite Origin заголовка = полный обход CORS
# ============================================
VITE_API_URL=http://192.168.1.97/api
VITE_BACKEND_TARGET=http://192.168.1.97
VITE_CORS_ORIGIN=http://192.168.1.97
